# pymongo's build backend, for the Alpine builds (py2exe_alpine.sh): pymongo
# publishes no musllinux and no pure-Python wheel, so Alpine builds it from its
# sdist (pymongo-alpine.in) without build isolation, against these. Its
# pyproject.toml requires hatchling>1.24, setuptools>=65 (already pinned in
# build-tools.txt, which constrains this file) and hatch-requirements-txt>=0.4.1.
hatchling>1.24
hatch-requirements-txt>=0.4.1
