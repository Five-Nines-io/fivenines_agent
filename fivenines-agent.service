[Unit]
Description=Five Nines monitoring agent

[Service]
Type=notify
User=fivenines
# Journal read access, needed by two collectors: the log-monitoring collector
# (journald capability) and the systemd collector's failure drilldown
# (journalctl tail). Without it, captures/tails degrade silently to empty on
# system installs. The group ships with systemd's sysusers config on every
# packaged distro. Caveat: on hand-rolled images that stripped the group,
# systemd fails the unit with status 216/GROUP -- remove this line there.
SupplementaryGroups=systemd-journal
# WireGuard peer health. `wg show all dump` reads device state over netlink,
# which needs root or CAP_NET_ADMIN; granting the one capability is strictly
# less privilege than User=root. Ambient capabilities are inherited across
# execve, so the `wg` child gets it too.
#
# Two things to know before keeping this:
#   - It applies to EVERY install, not just WireGuard hosts. CAP_NET_ADMIN can
#     reconfigure interfaces and firewall rules, so if you do not monitor
#     WireGuard, deleting this line costs you nothing: the collector then
#     reports null (a collection failure the server ignores) rather than an
#     empty peer list, so no monitoring data is falsely resolved.
#   - It needs systemd >= 229. Older systemd logs "Unknown key name" and
#     ignores the line; the unit still starts, WireGuard collection just
#     reports null.
AmbientCapabilities=CAP_NET_ADMIN
ExecStart=/opt/fivenines/fivenines_agent
RestartSec=5
Restart=always
WatchdogSec=90
NotifyAccess=all

# --- Sandbox hardening -------------------------------------------------------
# MOUNT-NAMESPACE / ATTRIBUTE directives only. This is the load-bearing rule:
# on a NON-ROOT unit (User=fivenines), every seccomp-backed directive
# (ProtectKernelTunables/Modules/Logs, ProtectClock, RestrictRealtime,
# LockPersonality, RestrictSUIDSGID, SystemCallFilter, ...) makes systemd
# implicitly enable NoNewPrivileges -- seccomp without CAP_SYS_ADMIN requires
# no_new_privs (see systemd's context_has_no_new_privileges()) -- and
# no_new_privs breaks every `sudo -n smartctl/mdadm/fail2ban-client` spawn:
# SMART, RAID and fail2ban monitoring would silently die fleet-wide on any
# systemd >= 228 host. Do not add ANY directive from that family here.
#
# Also deliberately ABSENT, for the same or adjacent reasons:
#   NoNewPrivileges       - breaks sudo (setuid) outright.
#   CapabilityBoundingSet - sudo needs the full root set post-setuid for
#                           SMART ioctls and md admin.
#   ProtectSystem=full/strict - /etc goes read-only, breaking the TOKEN swap
#                           and the state files under /etc/fivenines_agent
#                           (ReadWritePaths needs systemd >= 231, and on older
#                           systemd the exception would be IGNORED while the
#                           read-only mount still applied -- silently degraded
#                           enrollment on exactly the old-distro hosts).
#   MemoryDenyWriteExecute - pynvml/libvirt load native code via ctypes/libffi.
#
# State files the agent CREATES (TOKEN swap, capture/inventory state) default
# to owner-only under this umask even if the code ever regresses to plain
# open(); the code additionally fchmods to 0600 to heal pre-existing files.
UMask=0077
# The agent itself never uses /tmp; a private one removes a whole
# symlink/tmpfile attack class for it and every child it spawns. Caveat: it
# also hides OTHER services' /tmp unix sockets from the agent's children --
# a MySQL/PostgreSQL reached via a /tmp socket path (upstream-tarball
# defaults: /tmp/mysql.sock, /tmp/.s.PGSQL.5432) will read as unreachable.
# Such hosts should override with a drop-in: `systemctl edit fivenines-agent`
# -> [Service] PrivateTmp=no. Distro packages use /var/run, so this is rare.
PrivateTmp=true
# Read-only view of home directories: the agent only expanduser()s for its own
# user context, never writes there.
ProtectHome=read-only

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
